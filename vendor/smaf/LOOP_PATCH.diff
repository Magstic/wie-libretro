+/// Returns the playback duration of a parsed SMAF event stream in milliseconds.
+///
+/// The parser emits one or more [`SmafEvent::End`] markers, but for looping the
+/// practical loop length is the maximum timestamp in the merged event stream.
+pub fn smaf_duration(events: &[(usize, SmafEvent)]) -> usize {
+    events.iter().map(|(time, _)| *time).max().unwrap_or(0)
+}
+
+/// Repeats an already parsed SMAF event stream a finite number of times.
+///
+/// `play_count` is the total number of plays, not the number of extra repeats:
+/// `1` returns the original timing, `2` plays the stream twice, and `0` returns
+/// only an immediate end marker. Intermediate [`SmafEvent::End`] markers are
+/// removed so callers only see one final end marker.
+pub fn repeat_smaf_events(events: &[(usize, SmafEvent)], play_count: usize) -> Vec<(usize, SmafEvent)> {
+    let duration = smaf_duration(events);
+    let mut result = Vec::new();
+
+    if play_count == 0 {
+        result.push((0, SmafEvent::End));
+        return result;
+    }
+
+    if duration == 0 {
+        result.extend(events.iter().cloned());
+        return result;
+    }
+
+    let non_end_count = events.iter().filter(|(_, event)| !matches!(event, SmafEvent::End)).count();
+    result.reserve(non_end_count.saturating_mul(play_count).saturating_add(1));
+
+    for iteration in 0..play_count {
+        let offset = duration.saturating_mul(iteration);
+        for (time, event) in events.iter() {
+            if matches!(event, SmafEvent::End) {
+                continue;
+            }
+            result.push((offset.saturating_add(*time), event.clone()));
+        }
+    }
+
+    result.push((duration.saturating_mul(play_count), SmafEvent::End));
+    result.sort_by_key(|&(time, _)| time);
+    result
+}
+
+/// Parses a SMAF/MMF file and repeats the resulting event stream a finite number
+/// of times. See [`repeat_smaf_events`] for the exact `play_count` semantics.
+pub fn parse_smaf_repeated(raw: &[u8], play_count: usize) -> Vec<(usize, SmafEvent)> {
+    let events = parse_smaf(raw);
+    repeat_smaf_events(&events, play_count)
+}
